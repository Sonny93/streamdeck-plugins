{
	"name": "streamdeck-plugins",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously",
		"format": "pnpm lint:fix && oxfmt .",
		"format:check": "oxfmt . --check",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"build": "pnpm -r run build",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
	},
	"devDependencies": {
		"@minimalstuff/tooling": "^0.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003"
	}
}
