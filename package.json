{
	"name": "streamdeck-plugins",
	"version": "1.2.0-next.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously",
		"format": "pnpm lint:fix && oxfmt .",
		"format:check": "oxfmt . --check",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r --workspace-concurrency=1 run test",
		"build": "pnpm -r run build",
		"package": "pnpm --filter release-tools run package",
		"profile:import": "pnpm --filter release-tools run profile:import",
		"release": "release-it",
		"release:next": "release-it --preRelease=next --plugins.@release-it/keep-a-changelog.keepUnreleased=true",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
	},
	"devDependencies": {
		"@minimalstuff/tooling": "^0.9.0",
		"@release-it/keep-a-changelog": "^8.0.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"release-it": "^21.1.2"
	},
	"packageManager": "pnpm@12.18.0"
}
