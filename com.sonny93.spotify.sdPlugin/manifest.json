{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Spotify Deck",
	"Version": "0.1.0.0",
	"Author": "Sonny93",
	"Description": "Control the Spotify desktop app directly from Stream Deck.",
	"UUID": "com.sonny93.spotify",
	"Category": "Spotify Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": { "MinimumVersion": "7.1" },
	"OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
	"Nodejs": { "Version": "24", "Debug": "enabled" },
	"Profiles": [
		{
			"Name": "profiles/spotify-deck",
			"DeviceType": 7,
			"AutoInstall": true,
			"DontAutoSwitchWhenInstalled": false,
			"Readonly": false
		}
	],
	"Actions": [
		{
			"Name": "Open search",
			"UUID": "com.sonny93.spotify.open-search",
			"Icon": "imgs/actions/open-search/icon",
			"Tooltip": "Bring Spotify to front with the search field focused.",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/open-search/key" }]
		},
		{
			"Name": "Toggle lyrics",
			"UUID": "com.sonny93.spotify.toggle-lyrics",
			"PropertyInspectorPath": "ui/toggle_lyrics_settings.html",
			"Icon": "imgs/actions/toggle-lyrics/icon",
			"Tooltip": "Show or hide the lyrics view.",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{ "Image": "imgs/actions/toggle-lyrics/key" },
				{ "Image": "imgs/actions/toggle-lyrics/key-unavailable" }
			]
		},
		{
			"Name": "Toggle full screen",
			"UUID": "com.sonny93.spotify.toggle-fullscreen",
			"PropertyInspectorPath": "ui/toggle_fullscreen_settings.html",
			"Icon": "imgs/actions/toggle-fullscreen/icon",
			"Tooltip": "Enter or exit Spotify full screen mode.",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/toggle-fullscreen/key" }]
		},
		{
			"Name": "Play / Pause",
			"UUID": "com.sonny93.spotify.play-pause",
			"Icon": "imgs/actions/play-pause/icon",
			"Tooltip": "Play or pause the current track.",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{ "Image": "imgs/actions/play-pause/key-play" },
				{ "Image": "imgs/actions/play-pause/key-pause" }
			]
		},
		{
			"Name": "Previous track",
			"UUID": "com.sonny93.spotify.previous-track",
			"Icon": "imgs/actions/previous-track/icon",
			"Tooltip": "Skip to the previous track.",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/previous-track/key" }]
		},
		{
			"Name": "Next track",
			"UUID": "com.sonny93.spotify.next-track",
			"Icon": "imgs/actions/next-track/icon",
			"Tooltip": "Skip to the next track.",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/next-track/key" }]
		},
		{
			"Name": "Like",
			"UUID": "com.sonny93.spotify.like",
			"Icon": "imgs/actions/like/icon",
			"Tooltip": "Add the current track to the playlist picked on the Playlists dial (Liked Songs by default).",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/like/key",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/like/key-saved",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Playlists",
			"UUID": "com.sonny93.spotify.playlists",
			"Icon": "imgs/actions/playlists/icon",
			"Tooltip": "Browse your playlists, play one, or add the playing track to one.",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/playlists.json",
				"TriggerDescription": {
					"Rotate": "Browse playlists",
					"Push": "Play playlist",
					"Touch": "Add the playing track"
				}
			},
			"States": [{ "Image": "imgs/actions/playlists/key" }]
		}
	]
}
