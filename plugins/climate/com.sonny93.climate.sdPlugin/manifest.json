{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Climate Deck",
	"Version": "0.1.0.0",
	"Author": "Sonny93",
	"Description": "Control a Daikin air conditioner from Stream Deck over your local network: power, target temperature, presets, fan, special modes, info and energy.",
	"UUID": "com.sonny93.climate",
	"Category": "Climate Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "Climate",
			"UUID": "com.sonny93.climate.dial",
			"Icon": "imgs/actions/climate/icon",
			"Tooltip": "Chooses the target temperature of the air conditioner with the dial and applies it with a push. Shows the room temperature.",
			"PropertyInspectorPath": "ui/dial_settings.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/climate.json",
				"Icon": "imgs/actions/climate/dial-icon",
				"TriggerDescription": {
					"Rotate": "Choose the target temperature",
					"Push": "Apply it (hold to cancel it)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/climate/key"
				}
			]
		},
		{
			"Name": "Fan dial",
			"UUID": "com.sonny93.climate.fan-dial",
			"Icon": "imgs/actions/fan-dial/icon",
			"Tooltip": "Changes the fan rate by turning the dial, and switches the swing on and off with a push.",
			"PropertyInspectorPath": "ui/fan_dial_settings.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/climate.json",
				"Icon": "imgs/actions/fan-dial/dial-icon",
				"TriggerDescription": {
					"Rotate": "Change the fan rate",
					"Push": "Switch the swing on / off"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/fan-dial/key"
				}
			]
		},
		{
			"Name": "Info",
			"UUID": "com.sonny93.climate.info",
			"Icon": "imgs/actions/info/icon",
			"Tooltip": "Shows the outdoor temperature, whether the compressor runs and the active special modes.",
			"PropertyInspectorPath": "ui/info_settings.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/climate.json",
				"Icon": "imgs/actions/info/dial-icon"
			},
			"States": [
				{
					"Image": "imgs/actions/info/key"
				}
			]
		},
		{
			"Name": "Energy",
			"UUID": "com.sonny93.climate.energy",
			"Icon": "imgs/actions/energy/icon",
			"Tooltip": "Shows the energy the air conditioner used today and over the last 7 days.",
			"PropertyInspectorPath": "ui/energy_settings.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/climate.json",
				"Icon": "imgs/actions/energy/dial-icon"
			},
			"States": [
				{
					"Image": "imgs/actions/energy/key"
				}
			]
		},
		{
			"Name": "Power",
			"UUID": "com.sonny93.climate.power",
			"Icon": "imgs/actions/power/icon",
			"Tooltip": "Turns the air conditioner on or off, lights up while it is on and shows the room temperature.",
			"PropertyInspectorPath": "ui/power_settings.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/power/key-off"
				},
				{
					"Image": "imgs/actions/power/key"
				},
				{
					"Image": "imgs/actions/power/key-unavailable"
				}
			]
		},
		{
			"Name": "Preset",
			"UUID": "com.sonny93.climate.preset",
			"Icon": "imgs/actions/preset/icon",
			"Tooltip": "Puts the air conditioner in a mode, at a temperature and a fan rate, and lights up while it matches.",
			"PropertyInspectorPath": "ui/preset_settings.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/preset/key-off"
				},
				{
					"Image": "imgs/actions/preset/key"
				},
				{
					"Image": "imgs/actions/preset/key-unavailable"
				}
			]
		},
		{
			"Name": "Fan",
			"UUID": "com.sonny93.climate.fan",
			"Icon": "imgs/actions/fan/icon",
			"Tooltip": "Goes to the next fan rate on each press, or switches the swing on and off.",
			"PropertyInspectorPath": "ui/fan_settings.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/fan/key-off"
				},
				{
					"Image": "imgs/actions/fan/key"
				},
				{
					"Image": "imgs/actions/fan/key-unavailable"
				}
			]
		},
		{
			"Name": "Special mode",
			"UUID": "com.sonny93.climate.special-mode",
			"Icon": "imgs/actions/special-mode/icon",
			"Tooltip": "Switches the powerful or the econo mode of the air conditioner, and lights up while it is active.",
			"PropertyInspectorPath": "ui/special_mode_settings.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/special-mode/key-off"
				},
				{
					"Image": "imgs/actions/special-mode/key"
				},
				{
					"Image": "imgs/actions/special-mode/key-unavailable"
				}
			]
		}
	]
}
