{
	"name": "audio-deck",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"pnpm run restart\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart_plugin.ps1"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.3",
		"koffi": "^3.3.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.3",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "~24.19.2",
		"rollup": "^4.65.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
