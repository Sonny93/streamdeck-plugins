{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"customConditions": ["node"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
